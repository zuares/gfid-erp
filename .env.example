APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://promoter-quintuple-domelike.ngrok-free.dev

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Shopee API logs tetap memakai database utama sampai dipindahkan dengan command.
SHOPEE_API_LOG_CONNECTION=sqlite
SHOPEE_PRINCIPAL_ID=
# DB_LOGS_DATABASE=/absolute/path/to/logs.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Queue settlement/finance berat: retry_after harus lebih panjang dari timeout worker.
DB_HEAVY_QUEUE_RETRY_AFTER=3300

CACHE_STORE=database
CACHE_LIMITER=database

# Shopee: tunggu cooldown rate-limit pendek pada request web sebelum retry
SHOPEE_WEB_RATE_LIMIT_MAX_WAIT=10
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# TikTok Shop OAuth / Open API
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_SERVICE_ID=
TIKTOK_SHOP_SELLER_AUTH_URL=https://services.tiktokshop.com/open/authorize
TIKTOK_SHOP_REDIRECT_URI="${APP_URL}/marketplace/tiktok/callback"
TIKTOK_SHOP_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_SHOP_AUTH_URL=https://auth.tiktok-shops.com
# Finance statement scan window; order sync window remains controlled by the command.
TIKTOK_FINANCE_STATEMENT_LOOKBACK_DAYS=7
TIKTOK_SHIPPING_WEIGHT_GRAM=1000
TIKTOK_SHIPPING_LENGTH_CM=20
TIKTOK_SHIPPING_WIDTH_CM=15
TIKTOK_SHIPPING_HEIGHT_CM=5

# Marketplace finance
MARKETPLACE_ADS_VAT_PERCENT=11
MARKETPLACE_FINANCE_ORDER_SYNC_STORE_NAME=Greatfit.id
MARKETPLACE_FINANCE_ORDER_SYNC_ENABLED=false
MARKETPLACE_FINANCE_ORDER_SYNC_INTERVAL_MINUTES=15
MARKETPLACE_FINANCE_PILOT_SYNC_ENABLED=false

# Storefront shipping
RAJAONGKIR_API_KEY=i2MTzBZG5ca4bfe72bc8a60dLiVSKpiB
RAJAONGKIR_ORIGIN_ID=5138
RAJAONGKIR_COURIERS="jnt:wahana"
RAJAONGKIR_BASE_URL="https://rajaongkir.komerce.id/api/v1"
STOREFRONT_FALLBACK_SHIPPING_COST=
STOREFRONT_FALLBACK_SHIPPING_COURIER="Greatfit"
STOREFRONT_FALLBACK_SHIPPING_SERVICE="REG"
STOREFRONT_FALLBACK_SHIPPING_ETD="2-5"

BROADCAST_CONNECTION=log

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=ap1

VITE_BROADCAST_CONNECTION="${BROADCAST_CONNECTION}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# OpenAI / AI Agent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Audio ringtone upload (opsional; aplikasi juga mencari lokasi FFmpeg umum)
FFMPEG_BINARY=
FFPROBE_BINARY=

# OAuth Login
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_OAUTH_SCOPES="openid email profile"
GOOGLE_OAUTH_DEFAULT_ROLE=operating
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI="${APP_URL}/auth/github/callback"
GITHUB_OAUTH_SCOPES="read:user user:email"
OAUTH_DEFAULT_ROLE=operating

# Meta / Instagram Login (server-side OAuth)
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI="${APP_URL}/social-media/instagram/callback"
META_INSTAGRAM_API_VERSION=v25.0
META_INSTAGRAM_SCOPES="instagram_business_basic"
META_INSTAGRAM_HTTP_TIMEOUT=30

# WhatsApp / Fonnte (opsional — jangan commit token asli)
ADMIN_WA_NUMBER=
FONNTE_TOKEN=
FONNTE_API_URL=https://api.fonnte.com/send
