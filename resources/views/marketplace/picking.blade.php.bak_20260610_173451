<script>
// ═══════════════════════════════════════════════════════════
// DUMMY DATA — diganti fetch API setelah migration dijalankan
// ═══════════════════════════════════════════════════════════
const DUMMY = {
    ready_to_pick: [
        {
            id: 101, status: 'pending_review',
            order: { id: 1, channel_order_id: '260610ABC001', store: { name: 'Insight Corps', channel: 'Shopee' } },
            warehouse: { name: 'Gudang Rumah' },
            lines_count: 2, lines_picked: 0, lines_problem: 0, all_picked: false,
            lines: [
                { id: 1, marketplace_item_name: 'Kaos Putih Polos', marketplace_sku: 'KPP-L', qty_ordered: 3, qty_fulfilled: 3, is_picked: false, has_problem: false, pick_problem: null, item: { id: 10, name: 'Kaos Putih L', code: 'KPP-L' } },
                { id: 2, marketplace_item_name: 'Celana Jogger Hitam', marketplace_sku: 'CJH-M', qty_ordered: 1, qty_fulfilled: 1, is_picked: false, has_problem: false, pick_problem: null, item: { id: 11, name: 'Celana Jogger M', code: 'CJH-M' } },
            ]
        },
        {
            id: 102, status: 'pending_review',
            order: { id: 2, channel_order_id: '260610ABC002', store: { name: 'Insight Corps', channel: 'Tokopedia' } },
            warehouse: { name: 'Gudang Rumah' },
            lines_count: 3, lines_picked: 0, lines_problem: 0, all_picked: false,
            lines: [
                { id: 3, marketplace_item_name: 'Kaos Putih Polos', marketplace_sku: 'KPP-L', qty_ordered: 2, qty_fulfilled: 2, is_picked: false, has_problem: false, pick_problem: null, item: { id: 10, name: 'Kaos Putih L', code: 'KPP-L' } },
                { id: 4, marketplace_item_name: 'Polo Shirt Navy', marketplace_sku: 'PSN-M', qty_ordered: 1, qty_fulfilled: 1, is_picked: false, has_problem: false, pick_problem: null, item: { id: 12, name: 'Polo Shirt Navy M', code: 'PSN-M' } },
                { id: 5, marketplace_item_name: 'Kaos Putih Polos', marketplace_sku: 'KPP-XL', qty_ordered: 2, qty_fulfilled: 2, is_picked: false, has_problem: false, pick_problem: null, item: { id: 13, name: 'Kaos Putih XL', code: 'KPP-XL' } },
            ]
        },
        {
            id: 103, status: 'pending_review',
            order: { id: 3, channel_order_id: '260610ABC003', store: { name: 'Insight Corps', channel: 'Shopee' } },
            warehouse: { name: 'Gudang Rumah' },
            lines_count: 1, lines_picked: 0, lines_problem: 0, all_picked: false,
            lines: [
                { id: 6, marketplace_item_name: 'Celana Jogger Hitam', marketplace_sku: 'CJH-M', qty_ordered: 2, qty_fulfilled: 2, is_picked: false, has_problem: false, pick_problem: null, item: { id: 11, name: 'Celana Jogger M', code: 'CJH-M' } },
            ]
        },
    ],
    picking: [],
    problem: [],
    packed: [],
};

// ═══════════════════════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════════════════════
let state = {
    ready:    JSON.parse(JSON.stringify(DUMMY.ready_to_pick)),
    picklist: [],   // order IDs yang dipilih untuk generate
    checking: [],
    problem:  [],
    pack:     [],
};

let selectedReadyIds = new Set();
let activeTab = 'ready';

// modal state
let modalLineId     = null;
let modalFulfId     = null;
let resolveLineId   = null;
let resolveFulfId   = null;
let resolveItemId   = null;

// ═══════════════════════════════════════════════════════════
// TABS
// ═══════════════════════════════════════════════════════════
function switchTab(tab, btn) {
    activeTab = tab;
    document.querySelectorAll('.pk-tab').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.pk-panel').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('panel-' + tab).classList.add('active');
    renderAll();
}

// ═══════════════════════════════════════════════════════════
// RENDER
// ═══════════════════════════════════════════════════════════
function renderAll() {
    updateBadges();
    renderReady();
    renderChecking();
    renderProblem();
    renderPack();
}

function updateBadges() {
    document.getElementById('badge-ready').textContent    = state.ready.length;
    document.getElementById('badge-picklist').textContent = selectedReadyIds.size;
    document.getElementById('badge-checking').textContent = state.checking.length;
    document.getElementById('badge-problem').textContent  = state.problem.length;
    document.getElementById('badge-pack').textContent     = state.pack.length;
}

// ── Ready to Pick ──────────────────────────────────────────
function renderReady() {
    const el = document.getElementById('ready-list');
    if (!state.ready.length) {
        el.innerHTML = `<div class="pk-empty"><div class="pk-empty-icon">✅</div><div class="pk-empty-text">Semua order sudah diproses!</div></div>`;
        return;
    }
    document.getElementById('readySelectedInfo').innerHTML =
        `<strong>${selectedReadyIds.size}</strong> dipilih dari ${state.ready.length} order`;
    document.getElementById('btnGenPickList').disabled = selectedReadyIds.size === 0;

    el.innerHTML = state.ready.map(f => {
        const checked = selectedReadyIds.has(f.id) ? 'checked' : '';
        const totalQty = f.lines.reduce((s, l) => s + l.qty_ordered, 0);
        return `
        <div class="pk-card">
            <div class="pk-card-head" onclick="toggleReadySelect(${f.id})">
                <div class="pk-select-row">
                    <input type="checkbox" ${checked} onclick="event.stopPropagation();toggleReadySelect(${f.id})">
                    <div>
                        <div class="pk-order-no">${esc(f.order.channel_order_id)}</div>
                        <div class="pk-order-meta">${esc(f.order.store.name)} · ${esc(f.order.store.channel)} · ${f.lines_count} item · ${totalQty} pcs</div>
                    </div>
                </div>
                <span class="oc-badge oc-badge-amber">Siap Dipick</span>
            </div>
        </div>`;
    }).join('');
}

function toggleReadySelect(id) {
    if (selectedReadyIds.has(id)) selectedReadyIds.delete(id);
    else selectedReadyIds.add(id);
    renderAll();
}

function selectAllReady() {
    if (selectedReadyIds.size === state.ready.size) {
        selectedReadyIds.clear();
    } else {
        state.ready.forEach(f => selectedReadyIds.add(f.id));
    }
    renderAll();
}

// ── Generate Pick List ─────────────────────────────────────
function generatePickList() {
    if (!selectedReadyIds.size) return;
    switchTabByName('picklist');

    // Konsolidasi per item
    const selected  = state.ready.filter(f => selectedReadyIds.has(f.id));
    const itemMap   = new Map(); // itemCode → { name, sku, totalQty, orders[] }

    selected.forEach(f => {
        f.lines.forEach(l => {
            const key  = l.item?.code || l.marketplace_sku;
            const name = l.item?.name || l.marketplace_item_name;
            if (!itemMap.has(key)) {
                itemMap.set(key, { name, sku: l.marketplace_sku, totalQty: 0, orders: [] });
            }
            const entry = itemMap.get(key);
            entry.totalQty += l.qty_ordered;
            if (!entry.orders.includes(f.order.channel_order_id)) {
                entry.orders.push(f.order.channel_order_id);
            }
        });
    });

    document.getElementById('picklistOrderCount').textContent = selected.length;
    document.getElementById('picklistItemCount').textContent  = itemMap.size;

    const tbody = document.getElementById('picklist-body');
    tbody.innerHTML = [...itemMap.entries()].map(([code, d]) => `
        <tr>
            <td>
                <div class="pkl-item-name">${esc(d.name)}</div>
                <div class="pkl-item-sku">${esc(code)}</div>
            </td>
            <td class="pkl-qty">${d.totalQty}</td>
            <td>
                <div class="pkl-orders">
                    ${d.orders.map(o => `<span class="pkl-order-chip">${esc(o)}</span>`).join('')}
                </div>
            </td>
        </tr>
    `).join('');
}

function switchTabByName(tab) {
    const btn = document.querySelector(`.pk-tab[data-tab="${tab}"]`);
    if (btn) switchTab(tab, btn);
}

function printPickList() {
    window.print(); // TODO: buat popup print view
}

// ── Start Picking ──────────────────────────────────────────
function startPicking() {
    const selected = state.ready.filter(f => selectedReadyIds.has(f.id));
    selected.forEach(f => {
        f.status = 'picking';
        state.checking.push(f);
    });
    state.ready = state.ready.filter(f => !selectedReadyIds.has(f.id));
    selectedReadyIds.clear();
    switchTabByName('checking');
}

// ── Checklist Picked ───────────────────────────────────────
function renderChecking() {
    const el = document.getElementById('checking-list');
    // Juga ambil dari problem (untuk undo problem)
    const rows = state.checking;
    if (!rows.length) {
        el.innerHTML = `<div class="pk-empty"><div class="pk-empty-icon">📋</div><div class="pk-empty-text">Belum ada order yang sedang dipicking.</div></div>`;
        return;
    }
    el.innerHTML = rows.map(f => renderCheckingCard(f)).join('');
}

function renderCheckingCard(f) {
    const picked  = f.lines.filter(l => l.is_picked && !l.has_problem).length;
    const total   = f.lines.length;
    const pct     = total ? Math.round((picked / total) * 100) : 0;
    const allDone = picked === total && !f.lines.some(l => l.has_problem);

    return `
    <div class="pk-card" id="check-card-${f.id}">
        <div class="pk-card-head" onclick="this.closest('.pk-card').querySelector('.pk-card-body').classList.toggle('hidden-body')">
            <div>
                <div class="pk-order-no">${esc(f.order.channel_order_id)}</div>
                <div class="pk-order-meta">${esc(f.order.store.name)} · ${esc(f.order.store.channel)}</div>
            </div>
            <span class="oc-badge ${allDone ? 'oc-badge-green' : 'oc-badge-amber'}">
                ${picked}/${total} picked
            </span>
        </div>
        <div class="pk-card-body">
            <div class="pk-progress">
                <div class="pk-progress-bar" style="width:${pct}%"></div>
            </div>
            ${f.lines.map(l => renderCheckLine(f.id, l)).join('')}
        </div>
        <div class="pk-card-footer">
            ${allDone
                ? `<button class="pk-btn success" onclick="markPacked(${f.id})">✓ Siap Dikemas</button>`
                : `<button class="pk-btn" onclick="markPacked(${f.id})">Tandai Selesai</button>`
            }
        </div>
    </div>`;
}

function renderCheckLine(fulfId, l) {
    const checkClass = l.has_problem ? 'problem' : (l.is_picked ? 'checked' : '');
    const checkIcon  = l.has_problem ? '⚠' : (l.is_picked ? '✓' : '');
    return `
    <div class="pk-line" id="line-${fulfId}-${l.id}">
        <div class="pk-line-check ${checkClass}" onclick="togglePicked(${fulfId}, ${l.id})">${checkIcon}</div>
        <div class="pk-line-info">
            <div class="pk-line-name">${esc(l.item?.name || l.marketplace_item_name)}</div>
            <div class="pk-line-sku">${esc(l.marketplace_sku || '')}</div>
            ${l.has_problem ? `<div class="pk-problem-badge">⚠ ${esc(l.pick_problem)}</div>` : ''}
        </div>
        <div class="pk-line-qty">${l.qty_fulfilled} pcs</div>
        <div class="pk-line-actions">
            ${!l.is_picked && !l.has_problem
                ? `<button class="pk-btn-problem" onclick="openProblemModal(${fulfId}, ${l.id})">Problem</button>`
                : ''}
        </div>
    </div>`;
}

// ── Toggle picked ──────────────────────────────────────────
function togglePicked(fulfId, lineId) {
    const f = findFulfillment(fulfId);
    if (!f) return;
    const l = f.lines.find(x => x.id === lineId);
    if (!l || l.has_problem) return;
    l.is_picked = !l.is_picked;
    renderChecking();
}

// ── Mark packed (checklist done) ──────────────────────────
function markPacked(fulfId) {
    const f = findFulfillment(fulfId);
    if (!f) return;
    f.status = 'packed';
    state.checking = state.checking.filter(x => x.id !== fulfId);
    state.pack.push(f);
    renderAll();
}

// ── Problem ────────────────────────────────────────────────
function openProblemModal(fulfId, lineId) {
    modalFulfId = fulfId;
    modalLineId = lineId;
    document.getElementById('problemReason').value = 'Stok kosong di rak';
    toggleCustomReason();
    document.getElementById('problemModal').classList.remove('hidden');
}
function closeProblemModal() {
    document.getElementById('problemModal').classList.add('hidden');
}
function toggleCustomReason() {
    const val   = document.getElementById('problemReason').value;
    const show  = val === 'Lainnya';
    document.getElementById('customReasonLabel').style.display = show ? 'block' : 'none';
    document.getElementById('customReasonInput').style.display = show ? 'block' : 'none';
}
document.getElementById('problemReason').addEventListener('change', toggleCustomReason);

function submitProblem() {
    const reason = document.getElementById('problemReason').value === 'Lainnya'
        ? document.getElementById('customReasonInput').value || 'Masalah tidak diketahui'
        : document.getElementById('problemReason').value;
    const f = findFulfillment(modalFulfId);
    const l = f?.lines.find(x => x.id === modalLineId);
    if (l) {
        l.has_problem  = true;
        l.pick_problem = reason;
        l.is_picked    = false;
        // Tambah ke problem list jika belum ada
        if (!state.problem.find(x => x.id === f.id)) {
            state.problem.push(f);
        }
    }
    closeProblemModal();
    renderAll();
}

// ── Problem Order ──────────────────────────────────────────
function renderProblem() {
    const el = document.getElementById('problem-list');
    if (!state.problem.length) {
        el.innerHTML = `<div class="pk-empty"><div class="pk-empty-icon">✅</div><div class="pk-empty-text">Tidak ada problem order!</div></div>`;
        return;
    }
    el.innerHTML = state.problem.map(f => {
        const problemLines = f.lines.filter(l => l.has_problem);
        return `
        <div class="pk-card">
            <div class="pk-card-head">
                <div>
                    <div class="pk-order-no">${esc(f.order.channel_order_id)}</div>
                    <div class="pk-order-meta">${esc(f.order.store.name)} · ${problemLines.length} item bermasalah</div>
                </div>
                <span class="oc-badge oc-badge-red">⚠ Problem</span>
            </div>
            <div class="pk-card-body">
                ${problemLines.map(l => `
                <div class="pk-line">
                    <div class="pk-line-info">
                        <div class="pk-line-name">${esc(l.item?.name || l.marketplace_item_name)}</div>
                        <div class="pk-problem-badge">⚠ ${esc(l.pick_problem)}</div>
                    </div>
                    <div class="pk-line-qty">${l.qty_fulfilled} pcs</div>
                    <div class="pk-line-actions">
                        <button class="pk-btn" onclick="openResolveModal(${f.id}, ${l.id})">🔧 Fix</button>
                    </div>
                </div>`).join('')}
            </div>
        </div>`;
    }).join('');
}

function openResolveModal(fulfId, lineId) {
    resolveFulfId  = fulfId;
    resolveLineId  = lineId;
    resolveItemId  = null;
    const f = findFulfillment(fulfId);
    const l = f?.lines.find(x => x.id === lineId);
    document.getElementById('resolveItemSearch').value = '';
    document.getElementById('resolveItemResults').innerHTML = '';
    document.getElementById('resolveQty').value = l?.qty_ordered || 0;
    document.getElementById('resolveModal').classList.remove('hidden');
}
function closeResolveModal() {
    document.getElementById('resolveModal').classList.add('hidden');
}

function searchResolveItem(q) {
    // Dummy search dari lines yang ada
    const results = [
        { id: 10, name: 'Kaos Putih L',      code: 'KPP-L'  },
        { id: 11, name: 'Celana Jogger M',    code: 'CJH-M'  },
        { id: 12, name: 'Polo Shirt Navy M',  code: 'PSN-M'  },
        { id: 13, name: 'Kaos Putih XL',      code: 'KPP-XL' },
        { id: 14, name: 'Kaos Hitam M',       code: 'KHM-M'  },
    ].filter(i => q && (i.name.toLowerCase().includes(q.toLowerCase()) || i.code.toLowerCase().includes(q.toLowerCase())));

    document.getElementById('resolveItemResults').innerHTML = results.slice(0, 4).map(i => `
        <div onclick="selectResolveItem(${i.id}, '${esc(i.name)}')"
             style="padding:.35rem .65rem;border:1.5px solid #e2e8f0;border-radius:8px;cursor:pointer;margin-bottom:.25rem;font-size:.8rem;
                    background:${resolveItemId===i.id?'#f0fdf4':'#fff'}">
            <strong>${esc(i.code)}</strong> — ${esc(i.name)}
        </div>`).join('');
}

function selectResolveItem(id, name) {
    resolveItemId = id;
    document.getElementById('resolveItemSearch').value = name;
    document.getElementById('resolveItemResults').innerHTML = '';
}

function submitResolve() {
    const f = findFulfillment(resolveFulfId);
    const l = f?.lines.find(x => x.id === resolveLineId);
    if (l) {
        if (resolveItemId) l.item = { id: resolveItemId, name: document.getElementById('resolveItemSearch').value };
        l.qty_fulfilled = parseInt(document.getElementById('resolveQty').value) || l.qty_ordered;
        l.has_problem   = false;
        l.pick_problem  = null;
        l.is_picked     = true;
        // Hapus dari problem list jika tidak ada problem lines lagi
        const stillHasProblems = f.lines.some(x => x.has_problem);
        if (!stillHasProblems) {
            state.problem = state.problem.filter(x => x.id !== f.id);
        }
    }
    closeResolveModal();
    renderAll();
}

// ── Ready to Pack ──────────────────────────────────────────
function renderPack() {
    const el = document.getElementById('pack-list');
    if (!state.pack.length) {
        el.innerHTML = `<div class="pk-empty"><div class="pk-empty-icon">📦</div><div class="pk-empty-text">Belum ada order siap dikemas.</div></div>`;
        return;
    }
    el.innerHTML = state.pack.map(f => {
        const totalQty = f.lines.reduce((s, l) => s + l.qty_fulfilled, 0);
        return `
        <div class="pk-card">
            <div class="pk-card-head">
                <div>
                    <div class="pk-order-no">${esc(f.order.channel_order_id)}</div>
                    <div class="pk-order-meta">${esc(f.order.store.name)} · ${f.lines.length} item · ${totalQty} pcs</div>
                </div>
                <span class="oc-badge oc-badge-green">Siap Dikemas</span>
            </div>
            <div class="pk-card-body">
                ${f.lines.map(l => `
                <div class="pk-line">
                    <div class="pk-line-info">
                        <div class="pk-line-name">${esc(l.item?.name || l.marketplace_item_name)}</div>
                        <div class="pk-line-sku">${esc(l.marketplace_sku || '')}</div>
                    </div>
                    <div class="pk-line-qty">${l.qty_fulfilled} pcs</div>
                </div>`).join('')}
            </div>
            <div class="pk-card-footer">
                <button class="pk-btn" onclick="undoPack(${f.id})">↩ Undo</button>
                <button class="pk-btn success" onclick="confirmFulfillment(${f.id})">✓ Konfirmasi</button>
            </div>
        </div>`;
    }).join('');
}

function undoPack(fulfId) {
    const f = state.pack.find(x => x.id === fulfId);
    if (!f) return;
    f.status = 'picking';
    state.pack     = state.pack.filter(x => x.id !== fulfId);
    state.checking.push(f);
    switchTabByName('checking');
}

function confirmFulfillment(fulfId) {
    // TODO: POST /api/fulfillments/{id}/confirm
    const f = state.pack.find(x => x.id === fulfId);
    if (!f) return;
    state.pack = state.pack.filter(x => x.id !== fulfId);
    alert(`✓ Order ${f.order.channel_order_id} dikonfirmasi! (Dummy — stok belum dipotong)`);
    renderAll();
}

// ── Helpers ────────────────────────────────────────────────
function findFulfillment(id) {
    return [...state.ready, ...state.checking, ...state.problem, ...state.pack].find(f => f.id === id);
}
function esc(str) {
    if (!str) return '';
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// ── Init ───────────────────────────────────────────────────
renderAll();
</script>
@endpush
