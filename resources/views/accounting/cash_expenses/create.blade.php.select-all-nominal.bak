{{-- AUTO CLEAN DECIMAL AND FOCUS EDIT AMOUNT --}}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const selectors = [
        'input[name="amount"]',
        'input[name="nominal"]',
        'input[name="jumlah"]',
        'input[name="total"]'
    ];

    function clean(input) {
        if (!input) return;

        let value = String(input.value || '').trim();

        if (/^\d+\.00$/.test(value)) {
            value = value.replace(/\.00$/, '');
        }

        value = value.replace(/[^\d]/g, '');

        input.value = value;
        input.setAttribute('inputmode', 'numeric');
        input.setAttribute('pattern', '[0-9]*');
        input.setAttribute('step', '1');
        input.setAttribute('autocomplete', 'off');
    }

    document.querySelectorAll(selectors.join(',')).forEach(function (input) {
        clean(input);

        input.addEventListener('input', function () {
            clean(input);
        });

        input.addEventListener('blur', function () {
            clean(input);
        });
    });

    const amountInput = document.querySelector(selectors.join(','));
    if (amountInput) {
        setTimeout(function () {
            amountInput.focus({ preventScroll: false });
            amountInput.click();

            try {
                const len = amountInput.value.length;
                amountInput.setSelectionRange(len, len);
            } catch (e) {}
        }, 300);
    }
});
</script>

